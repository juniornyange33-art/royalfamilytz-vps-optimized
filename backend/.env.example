PORT=5000
CLIENT_URL=http://localhost:5173

# Firebase Admin — from Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email (Resend, or swap for SendGrid)
RESEND_API_KEY=
EMAIL_FROM=notifications@royalfamilytz.org

# Stripe (Visa / Mastercard)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=sandbox

# ClickPesa — Tanzanian mobile money (M-Pesa, Tigo Pesa, Airtel Money,
# HaloPesa) + card payments. Get these from https://merchant.clickpesa.com
# under Settings > Developers > Create Application (Integration Type: API).
CLICKPESA_CLIENT_ID=
CLICKPESA_API_KEY=
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties
# Optional — only set this if you enable "Checksum" on the application in
# the ClickPesa dashboard (adds payload signing on top of the JWT auth).
CLICKPESA_CHECKSUM_KEY=
