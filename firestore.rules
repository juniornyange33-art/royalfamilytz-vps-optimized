rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Users can read/update their own profile fields, but NEVER their own
    // role or membership status — those only change via the backend
    // (Admin SDK), which bypasses these rules entirely after verifying
    // a payment webhook or an admin action.
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.membershipActive == resource.data.membershipActive &&
        request.resource.data.membershipId == resource.data.membershipId;
      allow update: if isAdmin();
    }

    // Transactions are written only by the backend (Admin SDK) — never
    // directly by clients, since that's where money is tracked.
    match /transactions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /blogPosts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /notifications/{id} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /siteConfig/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /counters/{id} {
      allow read, write: if false; // backend-only, via Admin SDK
    }
  }
}
