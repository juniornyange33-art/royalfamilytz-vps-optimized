# Copy to .env on the VPS and replace every placeholder.
# Never commit or send the real .env file.
DOMAIN=royalfamilytz.org

MYSQL_DATABASE=royalfamilytz
MYSQL_USER=royalfamily
MYSQL_PASSWORD=CHANGE_TO_A_LONG_RANDOM_DATABASE_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_TO_A_DIFFERENT_LONG_RANDOM_ROOT_PASSWORD

CLICKPESA_CLIENT_ID=YOUR_PRODUCTION_CLICKPESA_CLIENT_ID
CLICKPESA_API_KEY=YOUR_PRODUCTION_CLICKPESA_API_KEY
CLICKPESA_CHECKSUM_KEY=YOUR_PRODUCTION_CLICKPESA_CHECKSUM_KEY
CLICKPESA_BASE_URL=https://api.clickpesa.com/third-parties

GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

MAIL_FROM=hello@royalfamilytz.org
MAIL_FROM_NAME=Royal Family Foundation
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=tls
SMTP_USER=YOUR_GMAIL_OR_DOMAIN_EMAIL
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD_OR_SMTP_PASSWORD
